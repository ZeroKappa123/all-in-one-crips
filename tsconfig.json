{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vitest/globals",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@/*": [
        "src/apt/*"
      ],
      "vue": [
        "src/apt/shims/vue.ts"
      ],
      "@vueuse/core": [
        "src/apt/shims/vueuse.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}