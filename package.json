{
  "name": "all-in-one-crips",
  "version": "1.0.0",
  "description": "All-In-One CRIPS \u2013 price checks and campaign guide for Path of Exile",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "tokens": "node scripts/tokens.mjs",
    "data:index": "node scripts/make-index-files.mjs",
    "update": "node scripts/update.mjs",
    "dist:zip": "electron-vite build && electron-builder --win zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sindresorhus/fnv1a": "^3.1.0",
    "dot-prop": "^9.0.0",
    "fast-deep-equal": "^3.1.3",
    "fast-xml-parser": "^4.5.7",
    "koffi": "^2.16.3",
    "lucide-react": "^1.67.0",
    "luxon": "^3.7.2",
    "neverthrow": "^8.2.0",
    "object-hash": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "author": "zero"
}
